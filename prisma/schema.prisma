// Turney — Painel de Mentoradas
// Banco: PostgreSQL (Neon). A URL vem de prisma.config.ts / lib/prisma.ts.

generator client {
  provider = "prisma-client-js"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Autenticação
// ---------------------------------------------------------------------------

model Usuario {
  id           String    @id @default(cuid())
  nome         String
  email        String    @unique
  senhaHash    String
  papel        String    @default("leitura") // admin | mentora | suporte | leitura (src/lib/permissoes.ts)
  pilares      String[]  @default([]) // comercial | marketing | posvenda (administradora vê todos)
  permissoes   String[]  @default([]) // cadastro | jornada | presencas | acompanhamento | comercial | excluir | equipe
  trocarSenha  Boolean   @default(false) // pede nova senha no próximo acesso
  ativo        Boolean   @default(true)
  ultimoAcesso DateTime?
  createdAt    DateTime  @default(now())

  sessoes    Sessao[]
  atividades Atividade[]
  foto       FotoUsuario?
}

// Foto de perfil (bolinha), já reduzida no navegador para 192×192 JPEG.
model FotoUsuario {
  usuarioId    String   @id
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  dados        Bytes
  tipo         String   @default("image/jpeg")
  atualizadaEm DateTime @updatedAt
}

// Registro de atividades: quem fez o quê e quando
model Atividade {
  id          String   @id @default(cuid())
  usuarioId   String?
  usuario     Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioNome String
  acao        String // criou | editou | excluiu | importou | entrou | saiu
  entidade    String // mentorada | etapa | presenca | acompanhamento | observacao | renovacao | varredura | usuario | sessao
  mentoradaId String?
  resumo      String
  detalhe     Json?
  data        DateTime @default(now())

  @@index([data])
  @@index([usuarioId, data])
  @@index([mentoradaId, data])
}

model Sessao {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm  DateTime
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

// ---------------------------------------------------------------------------
// Mentorada — cada estudante/mentorada acompanhada
// ---------------------------------------------------------------------------

model Mentorada {
  id     String  @id @default(cuid())
  // Código legado do HTML (ex: NX001, AT001)
  codigo String? @unique

  nome     String
  email    String?
  whatsapp String?
  tipo     String // Nexus | Atlas | ...
  status   String // Ativo | Encerrado | Churn | Em Renovação | Congelado
  saude    String? // Ativo | Risco | Crítico | Encerrado

  inicio  DateTime?
  prazo   DateTime?
  duracao Int? // meses

  area            String?
  localizacao     String?
  turma           String?
  produtoAnterior String?
  origem          String?
  origemDetalhe   String? // qual live/evento, quando a origem é Lives / Eventos
  resp            String? // responsável
  tutora          String?
  obs             String?

  // Jornada detalhada da automação (Make): id da linha da Config_Jornada e quando entrou nela
  jornadaEtapa   String?
  jornadaEtapaEm DateTime?

  // Pipeline (Kanban): em que etapa a mentorada está e desde quando
  pipelineFaseId String?
  pipelineFase   PipelineFase? @relation(fields: [pipelineFaseId], references: [id], onDelete: SetNull)
  pipelineFaseEm DateTime?

  linkedin           String?
  drive              String?
  asana              String?
  disc               String?
  mesesAntes         Int?
  cancelamento       DateTime?
  congelamentoPedido DateTime? // quando a mentorada pediu o congelamento
  congelamentoAte    DateTime? // até quando vai o congelamento
  congelamentoMotivo String? // por que a mentorada congelou
  vagaCargo          String?
  vagaEmpresa        String?
  vagaData           DateTime?
  renovacaoStatus    String? // Não iniciado | Call ofertada | Call agendada | Follow-up | Sem perspectiva
  negociacao         String?
  negociacaoEm       DateTime?
  saudeMotivo        String?
  saudeMotivoEm      DateTime?
  saudeNota          Int? // nota calculada 0-100 (src/lib/saude.ts)
  saudeCalculada     String? // nível que o cálculo indica
  saudeDetalhe       Json? // notas de cada parte do cálculo
  saudeAjusteEm      DateTime? // ajuste manual da saúde (vale até a próxima varredura)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  etapas          Etapa[]
  presencas       Presenca[]
  acompanhamentos Acompanhamento[]
  observacoes     Observacao[]
  renovacoes      Renovacao[]
  varreduraItens  VarreduraItem[]
  saudeRegistros  SaudeRegistro[]
  tarefas         Tarefa[]
  eventosAgenda   EventoAgenda[]
  eventosHubla    EventoHubla[]
  consumoHubla    ConsumoHubla[]
  vendas          Venda[]
}

// Etapas do Kanban (Pipeline), criadas e excluídas pela equipe.
// Se a etapa tiver tarefa automática, entrar nela cria a tarefa com prazo em dias úteis.
model PipelineFase {
  id              String   @id @default(cuid())
  nome            String
  ordem           Int
  tarefaTexto     String? // ex: "Enviar o roadmap"
  tarefaDiasUteis Int? // prazo contado a partir da data em que entrou na etapa
  createdAt       DateTime @default(now())

  mentoradas Mentorada[]
  tarefas    Tarefa[]
}

// Tarefas da equipe (criadas à mão ou automáticas pelo Pipeline).
model Tarefa {
  id           String        @id @default(cuid())
  titulo       String
  prazo        DateTime
  mentoradaId  String?
  mentorada    Mentorada?    @relation(fields: [mentoradaId], references: [id], onDelete: Cascade)
  faseId       String? // etapa do Pipeline que criou a tarefa automática
  fase         PipelineFase? @relation(fields: [faseId], references: [id], onDelete: SetNull)
  automatica   Boolean       @default(false)
  responsavel  String? // nome de quem vai fazer (vazio = quem cuida da mentorada)
  criadaPor    String?
  concluidaEm  DateTime?
  concluidaPor String?
  createdAt    DateTime      @default(now())

  @@index([concluidaEm, prazo])
  @@index([mentoradaId])
  @@index([responsavel])
}

model Observacao {
  id          String    @id @default(cuid())
  mentoradaId String
  mentorada   Mentorada @relation(fields: [mentoradaId], references: [id], onDelete: Cascade)
  data        DateTime
  texto       String
  autor       String?
  fixado      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([mentoradaId])
}

model Renovacao {
  id               String    @id @default(cuid())
  mentoradaId      String
  mentorada        Mentorada @relation(fields: [mentoradaId], references: [id], onDelete: Cascade)
  acao             String // RENOVAÇÃO | UPGRADE | DOWNGRADE | CROSS
  destino          String
  data             DateTime
  novoPrazo        DateTime?
  programaAnterior String?
  obs              String?
  createdAt        DateTime  @default(now())

  @@index([mentoradaId])
}

model Etapa {
  id          String    @id @default(cuid())
  mentoradaId String
  mentorada   Mentorada @relation(fields: [mentoradaId], references: [id], onDelete: Cascade)
  programa    String    @default("") // programa da jornada a que a etapa pertence (muda no upgrade)
  nome        String // onboarding | sessao | correcao | analise | entrevista | devolutiva | extra:<id> ...
  titulo      String? // nome exibido dos encontros extras personalizados
  obs         String?
  data        DateTime?
  createdAt   DateTime  @default(now())

  @@unique([mentoradaId, programa, nome])
  @@index([mentoradaId])
}

model Presenca {
  id          String    @id @default(cuid())
  mentoradaId String
  mentorada   Mentorada @relation(fields: [mentoradaId], references: [id], onDelete: Cascade)
  encontro    String // chave do encontro (ex: e1, e2, ...)
  presente    Boolean   @default(false)
  data        DateTime?
  createdAt   DateTime  @default(now())

  @@unique([mentoradaId, encontro])
  @@index([mentoradaId])
}

model Acompanhamento {
  id          String     @id @default(cuid())
  mentoradaId String
  mentorada   Mentorada  @relation(fields: [mentoradaId], references: [id], onDelete: Cascade)
  data        DateTime
  tipo        String?
  marco       Boolean    @default(false)
  marcoTitulo String?
  texto       String
  autor       String?
  varreduraId String?
  varredura   Varredura? @relation(fields: [varreduraId], references: [id], onDelete: Cascade)
  fixado      Boolean    @default(false)
  documento   Documento?
  createdAt   DateTime   @default(now())

  @@index([mentoradaId])
  @@index([varreduraId])
}

// Arquivo anexado a um registro do diário (ex: documento do roadmap)
model Documento {
  id               String         @id @default(cuid())
  acompanhamentoId String         @unique
  acompanhamento   Acompanhamento @relation(fields: [acompanhamentoId], references: [id], onDelete: Cascade)
  nome             String
  tipo             String
  conteudo         Bytes
  createdAt        DateTime       @default(now())
}

model Varredura {
  id        String   @id @default(cuid())
  data      DateTime
  programa  String?
  titulo    String?
  autor     String?
  bom       String[]
  ruim      String[]
  invisivel String[]
  melhorias String[]
  createdAt DateTime @default(now())

  itens           VarreduraItem[]
  acompanhamentos Acompanhamento[]

  @@index([data])
}

model VarreduraItem {
  id               String     @id @default(cuid())
  varreduraId      String
  varredura        Varredura  @relation(fields: [varreduraId], references: [id], onDelete: Cascade)
  mentoradaId      String?
  mentorada        Mentorada? @relation(fields: [mentoradaId], references: [id], onDelete: SetNull)
  nome             String
  banda            String // vermelho | amarelo | verde
  tag              String?
  etapa            String?
  status           String?
  concluido        String[]
  pendencias       String[]
  atencao          String[]
  acompanhar       String[]
  perguntar        String[]
  retornos         String[]
  proximos         String[]
  mensagem         String?
  prioridade       Int?
  prioridadeMotivo String?

  @@index([varreduraId])
  @@index([mentoradaId])
}

// Histórico da saúde: uma linha a cada mudança (permite ver a base mês a mês)
model SaudeRegistro {
  id          String    @id @default(cuid())
  mentoradaId String
  mentorada   Mentorada @relation(fields: [mentoradaId], references: [id], onDelete: Cascade)
  saude       String
  motivo      String?
  origem      String // inicial | cadastro | varredura | importacao | calculo
  data        DateTime  @default(now())

  @@index([mentoradaId, data])
  @@index([data])
}

// Agendas do Google lidas pelo painel (link iCal secreto de cada agenda).
model AgendaFonte {
  id            String    @id @default(cuid())
  nome          String // de quem é a agenda (ex.: Amanda Dutra)
  email         String? // e-mail da dona da agenda (para não confundir com o da mentorada)
  url           String // link iCal secreto — nunca mostrar inteiro na tela
  pilar         String    @default("posvenda") // posvenda | comercial: onde os compromissos aparecem
  ativo         Boolean   @default(true)
  ultimaLeitura DateTime?
  ultimoErro    String?
  eventos       Int? // quantos encontros vieram na última leitura
  criadaPor     String?
  createdAt     DateTime  @default(now())
}

// Encontros da agenda (janela de algumas semanas para trás e para frente), relidos a cada sincronização.
model EventoAgenda {
  id          String     @id @default(cuid())
  agenda      String // nome de quem é a agenda
  pilar       String     @default("posvenda")
  uid         String // UID do Google (+ ocorrência)
  titulo      String
  inicio      DateTime
  fim         DateTime?
  tipo        String // individual | grupo | onboarding | pessoal | outro | call (agendas do Comercial)
  link        String? // Google Meet
  convidados  Int        @default(0)
  mentoradaId String?
  mentorada   Mentorada? @relation(fields: [mentoradaId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([inicio])
  @@index([agenda, inicio])
}

// Tipo de encontro escolhido à mão (vale mais que a regra automática do título).
// escopo "evento" = só aquela ocorrência (chave = UID do Google); "titulo" = todos com o mesmo nome (chave = título normalizado).
model TipoEncontroManual {
  id        String   @id @default(cuid())
  escopo    String
  chave     String
  tipo      String // individual | grupo | onboarding | pessoal | outro
  titulo    String // título como estava na agenda (para mostrar)
  criadaPor String?
  createdAt DateTime @default(now())

  @@unique([escopo, chave])
}

// Configurações guardadas pela tela (ex.: token do webhook da Hubla).
model Configuracao {
  chave         String   @id
  valor         String
  atualizadaPor String?
  atualizadaEm  DateTime @updatedAt
}

// Área de membros da Hubla: acesso liberado/removido, módulo e curso concluídos.
// Só o necessário para o acompanhamento — nada de pagamento, documento ou endereço.
model EventoHubla {
  id          String     @id @default(cuid())
  chave       String     @unique // evita duplicar o mesmo aviso (a Hubla manda um por oferta)
  tipo        String // acesso_liberado | acesso_removido | modulo_concluido | curso_concluido
  email       String
  nome        String?
  produtoId   String?
  produto     String?
  modulo      String?
  data        DateTime
  mentoradaId String?
  mentorada   Mentorada? @relation(fields: [mentoradaId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([mentoradaId, data])
  @@index([email])
  @@index([data])
}

// Aulas assistidas na área de membros (relatório "Consumo do membro por conteúdo" da Hubla, importado em planilha).
// Cada importação substitui tudo: o relatório já traz o histórico completo.
model ConsumoHubla {
  id            String     @id @default(cuid())
  email         String
  nome          String?
  modulo        String
  conteudo      String
  tipo          String // Video, Publicação, Ebook, Live gravada, Imagem, Live
  visualizacoes Int        @default(0)
  conclusao     Int        @default(0) // 0 a 100
  primeiro      DateTime?
  ultimo        DateTime?
  mentoradaId   String?
  mentorada     Mentorada? @relation(fields: [mentoradaId], references: [id], onDelete: SetNull)

  @@index([mentoradaId])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Comercial
// ---------------------------------------------------------------------------

// Colunas do funil de vendas.
model FunilEtapa {
  id        String   @id @default(cuid())
  nome      String
  ordem     Int
  tipo      String   @default("aberta") // aberta | ganho | perdido
  createdAt DateTime @default(now())
  leads     Lead[]
}

model Lead {
  id                String               @id @default(cuid())
  nome              String
  whatsapp          String?
  email             String?
  instagram         String?
  origem            String?
  programa          String? // programa de interesse
  valorCentavos     Int? // valor estimado da proposta
  responsavel       String? // nome de quem está atendendo
  etapaId           String
  etapa             FunilEtapa           @relation(fields: [etapaId], references: [id], onDelete: Restrict)
  etapaEm           DateTime             @default(now())
  proximoPasso      String?
  proximoPassoEm    DateTime?
  motivoPerda       String?
  obs               String?
  criadoPor         String?
  // Vindo dos formulários (Respondi): quais, quando preencheu pela última vez e se é quente, morno ou frio.
  formularios       String[]             @default([])
  preenchidoEm      DateTime?
  temperatura       String? // quente | morno | frio
  temperaturaManual Boolean              @default(false) // escolhida à mão: novos preenchimentos não mudam
  pontuacao         Int? // 0 a 100
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  notas             LeadNota[]
  calls             Call[]
  vendas            Venda[]
  respostas         RespostaFormulario[]

  @@index([etapaId])
  @@index([responsavel])
  @@index([preenchidoEm])
}

// Cada preenchimento de formulário (Respondi) ligado ao lead.
model RespostaFormulario {
  id           String   @id // código da resposta no Respondi
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  formulario   String // HUB | Pré Mentoria | nome do formulário
  completa     Boolean  @default(true)
  canal        String? // resposta de "onde nos conheceu" / "chegou através do", como a pessoa marcou
  preenchidoEm DateTime
  pontuacao    Int?
  temperatura  String?
  respostas    Json // [{ p: pergunta, r: resposta }]
  utms         Json?
  createdAt    DateTime @default(now())

  @@index([leadId, preenchidoEm])
  @@index([preenchidoEm])
}

// Histórico do lead: anotações e movimentos.
model LeadNota {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tipo      String   @default("nota") // nota | etapa | call | venda
  texto     String
  autor     String?
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model Venda {
  id                 String     @id @default(cuid())
  leadId             String?
  lead               Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  cliente            String
  email              String?
  whatsapp           String?
  programa           String
  valorCentavos      Int
  pagamento          String? // como pagou (Pix, cartão 12x…)
  vendedora          String
  data               DateTime
  origem             String?
  inicio             DateTime? // início do contrato
  duracao            Int? // meses
  combinados         String? // o que foi combinado na negociação, vai para o Pós Venda
  cancelada          Boolean    @default(false)
  motivoCancelamento String?
  passagem           String     @default("pendente") // pendente | enviada | nao_precisa
  passagemEm         DateTime?
  passagemPor        String?
  mentoradaId        String?
  mentorada          Mentorada? @relation(fields: [mentoradaId], references: [id], onDelete: SetNull)
  criadoPor          String?
  createdAt          DateTime   @default(now())

  @@index([data])
  @@index([passagem])
}

// Meta do mês: vendedora vazia = meta da equipe inteira.
model MetaVenda {
  id            String @id @default(cuid())
  mes           String // AAAA-MM
  vendedora     String @default("")
  valorCentavos Int
  quantidade    Int?

  @@unique([mes, vendedora])
}

// Calls de venda: criadas à mão ou vindas da agenda do Google (guardadas quando ganham resultado ou lead).
model Call {
  id            String   @id @default(cuid())
  eventoChave   String?  @unique // "agenda|uid" do compromisso do Google
  leadId        String?
  lead          Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  titulo        String
  inicio        DateTime
  link          String?
  responsavel   String?
  resultado     String? // compareceu | faltou | remarcou | fechou
  obs           String?
  registradoPor String?
  createdAt     DateTime @default(now())

  @@index([inicio])
  @@index([leadId])
}
