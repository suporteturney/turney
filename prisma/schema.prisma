// Turney — Painel de Mentoradas
// Banco: PostgreSQL (Neon). A URL vem de prisma.config.ts / lib/prisma.ts.

generator client {
  provider = "prisma-client-js"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Autenticação
// ---------------------------------------------------------------------------

model Usuario {
  id           String    @id @default(cuid())
  nome         String
  email        String    @unique
  senhaHash    String
  papel        String    @default("leitura") // admin | mentora | suporte | leitura (src/lib/permissoes.ts)
  permissoes   String[]  @default([]) // cadastro | jornada | presencas | acompanhamento | comercial | excluir | equipe
  trocarSenha  Boolean   @default(false) // pede nova senha no próximo acesso
  ativo        Boolean   @default(true)
  ultimoAcesso DateTime?
  createdAt    DateTime  @default(now())

  sessoes    Sessao[]
  atividades Atividade[]
}

// Registro de atividades: quem fez o quê e quando
model Atividade {
  id          String   @id @default(cuid())
  usuarioId   String?
  usuario     Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioNome String
  acao        String // criou | editou | excluiu | importou | entrou | saiu
  entidade    String // mentorada | etapa | presenca | acompanhamento | observacao | renovacao | varredura | usuario | sessao
  mentoradaId String?
  resumo      String
  detalhe     Json?
  data        DateTime @default(now())

  @@index([data])
  @@index([usuarioId, data])
  @@index([mentoradaId, data])
}

model Sessao {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm  DateTime
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

// ---------------------------------------------------------------------------
// Mentorada — cada estudante/mentorada acompanhada
// ---------------------------------------------------------------------------

model Mentorada {
  id   String @id @default(cuid())
  // Código legado do HTML (ex: NX001, AT001)
  codigo String? @unique

  nome      String
  email     String?
  whatsapp  String?
  tipo      String  // Nexus | Atlas | ...
  status    String  // Ativo | Encerrado | Churn | Em Renovação
  saude     String? // Ativo | Risco | Crítico | Encerrado

  inicio  DateTime?
  prazo   DateTime?
  duracao Int?      // meses

  area            String?
  localizacao     String?
  turma           String?
  produtoAnterior String?
  origem          String?
  origemDetalhe   String? // qual live/evento, quando a origem é Lives / Eventos
  resp            String? // responsável
  obs             String?

  linkedin     String?
  drive        String?
  asana        String?
  disc         String?
  mesesAntes   Int?
  cancelamento DateTime?
  vagaCargo    String?
  vagaEmpresa  String?
  vagaData     DateTime?
  renovacaoStatus String? // Não iniciado | Call ofertada | Call agendada | Follow-up | Sem perspectiva
  negociacao   String?
  negociacaoEm DateTime?
  saudeMotivo   String?
  saudeMotivoEm DateTime?
  saudeNota      Int?      // nota calculada 0-100 (src/lib/saude.ts)
  saudeCalculada String?   // nível que o cálculo indica
  saudeDetalhe   Json?     // notas de cada parte do cálculo
  saudeAjusteEm  DateTime? // ajuste manual da saúde (vale até a próxima varredura)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  etapas    Etapa[]
  presencas Presenca[]
  acompanhamentos Acompanhamento[]
  observacoes Observacao[]
  renovacoes  Renovacao[]
  varreduraItens VarreduraItem[]
  saudeRegistros SaudeRegistro[]
}

model Observacao {
  id          String    @id @default(cuid())
  mentoradaId String
  mentorada   Mentorada @relation(fields: [mentoradaId], references: [id], onDelete: Cascade)
  data        DateTime
  texto       String
  autor       String?
  createdAt   DateTime  @default(now())

  @@index([mentoradaId])
}

model Renovacao {
  id          String    @id @default(cuid())
  mentoradaId String
  mentorada   Mentorada @relation(fields: [mentoradaId], references: [id], onDelete: Cascade)
  acao        String    // RENOVAÇÃO | UPGRADE | DOWNGRADE | CROSS
  destino     String
  data        DateTime
  novoPrazo   DateTime?
  programaAnterior String?
  obs         String?
  createdAt   DateTime  @default(now())

  @@index([mentoradaId])
}

model Etapa {
  id          String    @id @default(cuid())
  mentoradaId String
  mentorada   Mentorada @relation(fields: [mentoradaId], references: [id], onDelete: Cascade)
  programa    String    @default("") // programa da jornada a que a etapa pertence (muda no upgrade)
  nome        String    // onboarding | sessao | correcao | analise | entrevista | devolutiva | extra:<id> ...
  titulo      String?   // nome exibido dos encontros extras personalizados
  obs         String?
  data        DateTime?
  createdAt   DateTime  @default(now())

  @@unique([mentoradaId, programa, nome])
  @@index([mentoradaId])
}

model Presenca {
  id          String    @id @default(cuid())
  mentoradaId String
  mentorada   Mentorada @relation(fields: [mentoradaId], references: [id], onDelete: Cascade)
  encontro    String    // chave do encontro (ex: e1, e2, ...)
  presente    Boolean   @default(false)
  data        DateTime?
  createdAt   DateTime  @default(now())

  @@unique([mentoradaId, encontro])
  @@index([mentoradaId])
}

model Acompanhamento {
  id          String    @id @default(cuid())
  mentoradaId String
  mentorada   Mentorada @relation(fields: [mentoradaId], references: [id], onDelete: Cascade)
  data        DateTime
  tipo        String?
  marco       Boolean   @default(false)
  marcoTitulo String?
  texto       String
  autor       String?
  varreduraId String?
  varredura   Varredura? @relation(fields: [varreduraId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([mentoradaId])
  @@index([varreduraId])
}

model Varredura {
  id        String   @id @default(cuid())
  data      DateTime
  programa  String?
  titulo    String?
  autor     String?
  bom       String[]
  ruim      String[]
  invisivel String[]
  melhorias String[]
  createdAt DateTime @default(now())

  itens           VarreduraItem[]
  acompanhamentos Acompanhamento[]

  @@index([data])
}

model VarreduraItem {
  id               String     @id @default(cuid())
  varreduraId      String
  varredura        Varredura  @relation(fields: [varreduraId], references: [id], onDelete: Cascade)
  mentoradaId      String?
  mentorada        Mentorada? @relation(fields: [mentoradaId], references: [id], onDelete: SetNull)
  nome             String
  banda            String     // vermelho | amarelo | verde
  tag              String?
  etapa            String?
  status           String?
  concluido        String[]
  pendencias       String[]
  atencao          String[]
  acompanhar       String[]
  perguntar        String[]
  retornos         String[]
  proximos         String[]
  mensagem         String?
  prioridade       Int?
  prioridadeMotivo String?

  @@index([varreduraId])
  @@index([mentoradaId])
}

// Histórico da saúde: uma linha a cada mudança (permite ver a base mês a mês)
model SaudeRegistro {
  id          String    @id @default(cuid())
  mentoradaId String
  mentorada   Mentorada @relation(fields: [mentoradaId], references: [id], onDelete: Cascade)
  saude       String
  motivo      String?
  origem      String    // inicial | cadastro | varredura | importacao | calculo
  data        DateTime  @default(now())

  @@index([mentoradaId, data])
  @@index([data])
}
